 136          /**
 137            * @brief    初始化定时器,12T模式,16位自动重装
 138            * @note     注意必须用1T模式,这里需要更改
 139            * @param    无
 140            * @retval   无
 141            */
 142          void Timer0_Init(void)    
 143          {
 144   1        //这里是导致调试了三天的地方,原来默认设置1T模式
 145   1        //把 |= 0x80 改为 &= 0x7F，强制设为 12T 模式！
 146   1        // 这样在 12MHz 晶振下，定时器刚好 1微秒(us) 计数加 1。
 147   1        AUXR &= 0x7F;     
 148   1        
 149   1        TMOD &= 0xF0;     // 清除定时器0的模式位
 150   1        TMOD |= 0x01;     // 设置定时器模式为 16位不自动重装载 (Mode 1)
 151   1        
 152   1        Red_TLx = 0x0;        // 设置定时初始值
 153   1        Red_THx = 0x0;        // 设置定时初始值
 154   1        TF0 = 0;          // 清除TF0标志
 155   1        TR0 = 0;          // 初始化时先不开启定时器，等外部下降沿来了再开
 156   1        
 157   1        ET0 = 1;          //定时器中断
 158   1      }
